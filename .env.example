# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint, e.g. http://127.0.0.1:20128/v1 for local 9Router.
OPENAI_BASE_URL=
